{
  "schemaVersion": 1,
  "id": "mushokucraft",
  "version": "${version}",
  "name": "Mushoku Craft",
  "description": "Hardcore RPG mod inspired by Mushoku Tensei. Completely overhauls combat, magic, crafting and world exploration.",
  "authors": [
    "XxRaay"
  ],
  "contact": {},
  "license": "FCAIL-1.7",
  "icon": "assets/mushokucraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mushokucraft.fabric.MushokuCraftFabric"
    ],
    "client": [
      "com.mushokucraft.fabric.client.MushokuCraftFabricClient"
    ],
    "jei_mod_plugin": [
      "com.mushokucraft.compat.jei.MushokuJeiPlugin"
    ],
    "jei_plugins": [
      "com.mushokucraft.compat.jei.MushokuJeiPlugin"
    ]
  },
  "mixins": [
    "mushokucraft.mixins.json",
    "mushokucraft-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.2",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "architectury": "*"
  },
  "suggests": {
    "trinkets": ">=3.10.0",
    "jei": "*"
  }
}
