{
  "multipart": [
    {
      "when": { "north": "true" },
      "apply": { "model": "mushokucraft:block/barrier_wall_side" }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "mushokucraft:block/barrier_wall_side", "y": 90 }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "mushokucraft:block/barrier_wall_side", "y": 180 }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "mushokucraft:block/barrier_wall_side", "y": 270 }
    },
    {
      "when": { "north": "false", "east": "false", "south": "false", "west": "false" },
      "apply": { "model": "mushokucraft:block/barrier_wall_side" }
    }
  ]
}
